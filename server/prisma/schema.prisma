// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  firstName        String?
  lastName         String?
  email            String            @unique
  username         String?           @unique
  passwordHash     String
  rankings         Ranking[]
  rankingSessions  RankingSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Book {
  id               String            @id @default(uuid()) @db.Uuid
  googleId         String            @unique
  title            String
  authors          String[]
  compareStr       String
  rankings         Ranking[]
  rankingSteps     RankingStep[]
}

model Ranking {
  id               String            @id @default(uuid()) @db.Uuid
  bookId           String            @db.Uuid
  userId           String            @db.Uuid
  rawScore         Float
  level            Int              
  book             Book              @relation(fields: [bookId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([bookId])
  @@index([userId])
}

model RankingSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  rankingSteps     RankingStep[]

  @@index([userId])
}

model RankingStep {
  id               String            @id @default(uuid()) @db.Uuid
  bookId           String            @db.Uuid
  rankingSessionId String            @db.Uuid
  seq              Int
  low              Int
  high             Int
  level            Int
  createdAt        DateTime          @default(now())
  book             Book              @relation(fields: [bookId], references: [id])
  rankingSession   RankingSession    @relation(fields: [rankingSessionId], references: [id])


  @@index([bookId])
  @@index([rankingSessionId, seq])
  @@unique([rankingSessionId, seq])
}

model SearchCache {
  id               String            @id @default(uuid()) @db.Uuid
  query            String            @unique
  jsonResult       Json
  cachedAt         DateTime          @default(now())
}