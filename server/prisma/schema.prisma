// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  firstName        String?
  lastName         String?
  email            String            @unique
  username         String?           @unique
  passwordHash     String
  rankings         Ranking[]
  rankingSessions  RankingSession[]
  followers        Follow[]          @relation("Following")
  following        Follow[]          @relation("Follower")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Follow {
  fromId           String            @db.Uuid
  toId             String            @db.Uuid
  from             User              @relation("Followers", fields: [toId], references: [id])
  to               User              @relation("Followings", fields: [fromId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@id([followerId, followingId])
}

model Book {
  id               String            @id @default(uuid()) @db.Uuid
  googleId         String            @unique
  title            String
  authors          String[]
  compareStr       String
  rankings         Ranking[]
  rankingSessions  RankingSession[]
}

model Ranking {
  id               String            @id @default(uuid()) @db.Uuid
  bookId           String            @db.Uuid
  userId           String            @db.Uuid
  rawScore         Float
  level            Int              
  book             Book              @relation(fields: [bookId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([bookId])
  @@index([userId])
  @@unique([userId, bookId])
}

model RankingSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  bookId           String            @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  level            Int
  book             Book              @relation(fields: [bookId], references: [id])
  rankingSteps     RankingStep[]

  @@index([bookId])
  @@index([userId])
}

model RankingStep {
  id               String            @id @default(uuid()) @db.Uuid
  rankingSessionId String            @db.Uuid
  seq              Int
  low              Int
  high             Int
  skippedOffsets   Int[]             @default([])
  createdAt        DateTime          @default(now())
  rankingSession   RankingSession    @relation(fields: [rankingSessionId], references: [id])

  @@index([rankingSessionId])
  @@unique([rankingSessionId, seq])
}

model SearchCache {
  id               String            @id @default(uuid()) @db.Uuid
  query            String            @unique
  jsonResult       String
  cachedAt         DateTime          @default(now())
}