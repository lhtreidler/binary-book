// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  firstName       String?
  lastName        String?
  email           String           @unique
  username        String?          @unique
  passwordHash    String
  profileImg      String?
  rankings        Ranking[]
  rankingSessions RankingSession[]
  followers       Follow[]         @relation("Followings")
  followings      Follow[]         @relation("Followers")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookmarks       Bookmark[]
}

model Follow {
  fromId    String   @db.Uuid
  toId      String   @db.Uuid
  from      User     @relation("Followers", fields: [fromId], references: [id])
  to        User     @relation("Followings", fields: [toId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([fromId, toId])
}

model Book {
  id              String           @id @default(uuid()) @db.Uuid
  googleId        String           @unique
  title           String
  authors         String[]
  description     String?
  publishedDate   String?
  pageCount       Int?
  compareStr      String
  thumbnail       String?
  rankings        Ranking[]
  bookmarks       Bookmark[]
  rankingSessions RankingSession[]
  tags            Tag[]
}

model Tag {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @unique
  parentTagId     String?    @db.Uuid
  parentTag          Tag?     @relation("TagHierarchy", fields: [parentTagId], references: [id])
  childTags        Tag[]     @relation("TagHierarchy")
  books           Book[]

  @@index([name])
}

model Ranking {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @db.Uuid
  userId    String   @db.Uuid
  rawScore  Float
  level     Int
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @db.Uuid
  userId    String   @db.Uuid
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model RankingSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  bookId       String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  level        Int
  book         Book          @relation(fields: [bookId], references: [id])
  rankingSteps RankingStep[]

  @@index([bookId])
  @@index([userId])
}

model RankingStep {
  id               String         @id @default(uuid()) @db.Uuid
  rankingSessionId String         @db.Uuid
  seq              Int
  low              Int
  high             Int
  skippedOffsets   Int[]          @default([])
  createdAt        DateTime       @default(now())
  rankingSession   RankingSession @relation(fields: [rankingSessionId], references: [id])

  @@unique([rankingSessionId, seq])
  @@index([rankingSessionId])
}

model SearchCache {
  id         String   @id @default(uuid()) @db.Uuid
  query      String   @unique
  jsonResult Json
  cachedAt   DateTime @default(now())
}
